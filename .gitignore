# =========================================================================
# 🐍 PYTHON / FASTAPI
# =========================================================================
# Caché de bytes de Python
__pycache__/
*.py[cod]
*$py.class

# Herramientas de testing (pytest) y cobertura
.pytest_cache/
.coverage
htmlcov/
.tox/

# Entornos virtuales (por si alguien del equipo no usa Docker)
venv/
env/
.venv/
*.venv
pip-log.txt
pip-delete-this-directory.txt

# =========================================================================
# 🗄️ BASES DE DATOS LOCALES
# =========================================================================
# Ignorar bases de datos locales si usáis SQLite en algún momento
*.db
*.sqlite
*.sqlite3

# =========================================================================
# 🐳 DOCKER Y ENTORNO (¡CRÍTICO!)
# =========================================================================
# Protege las variables de entorno y credenciales
.env
.env.*
!.env.example

# Ignorar archivos override locales de Docker Compose si los creáis
docker-compose.override.yml

# =========================================================================
# 💻 IDEs Y SISTEMAS OPERATIVOS
# =========================================================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ / PyCharm
.idea/
*.iml
*.iws

# macOS / Windows
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =========================================================================
# 📁 UPLOADED FILES
# =========================================================================
uploads/